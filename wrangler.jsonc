{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hessen-rp",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "hessenrp-data",
      "id": "2b448fca85c54e01ac4377520343490b"
    }
  ],
  "observability": {
    "enabled": true
  }
}
