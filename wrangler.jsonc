{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hessen-rp",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "DATA_KV",
      "id": "DEINE_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
